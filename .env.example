# Generate with:
#   just gen-secret
REEF_SECRET=replace_with_64_lowercase_hex_chars

# Generate with:
#   just set-ssh-key ~/.ssh/id_ed25519
REEF_SSH_PRIVATE_KEY_B64=replace_with_base64_encoded_openssh_private_key

REEF_ENTRY_PORT_BASE=20000
REEF_EXIT_PORT=443
REEF_ENTRY_OVERRIDE_BASE_DOMAIN=example.com

# Optional Clash/Mihomo subscriptions: merge only nodes into our own templates.
# Number URLs consecutively from 1 and include them in REEF_WEB_ENV.
# For subscription-only use, keep REEF_SECRET and upstream URLs; omit all
# REEF_ENTRY_N / REEF_EXIT_N, REEF_ENTRY_OVERRIDE_BASE_DOMAIN, and the SSH key.
# REEF_UPSTREAM_URL_1=https://subscription.example.com/private-clash-url
# REEF_UPSTREAM_URL_2=https://another.example.com/private-clash-url
# Existing REEF_UPSTREAM_URL is also accepted and is merged first when set.

REEF_ENTRY_1=sg,172.28.0.10
REEF_ENTRY_2=jp,172.28.0.11

REEF_EXIT_1=us,172.28.0.20
REEF_EXIT_2=uk,172.28.0.21
